<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the form on screen and fills it in when the user dictates. Scanning is on demand
     (see FormAccessibilityService), so only the events needed to keep the service alive are listed. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200"
    android:description="@string/form_service_description" />
